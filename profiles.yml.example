# Kopiere diese Datei nach ~/.dbt/profiles.yml (Windows: C:\Users\<Name>\.dbt\profiles.yml)
# Account-Kennung: Snowsight » dein Name unten links » Konto » "View account details".
onlineshop:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "<orgname>-<accountname>"
      user: "<DEIN_BENUTZERNAME>"
      private_key_path: "C:/Users/<Name>/.dbt/rsa_key.p8"   # Key-Pair, kein Passwort
      role: transformer
      warehouse: lern_wh
      database: analytics
      schema: dev_dein_name
      threads: 4
